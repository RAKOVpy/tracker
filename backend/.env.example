# Скопируйте в .env (или задайте переменные окружения на сервере).

# Обязательно на сервере: длинная случайная строка, например из
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 0 — боевой режим. Без переменной — режим разработки.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=tracker.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tracker.example.com

# PostgreSQL. Без переменной — SQLite в backend/db.sqlite3 (для разработки).
DATABASE_URL=postgres://tracker:password@localhost:5432/tracker

# Открыта ли регистрация, пока администратор не переключил её в «Настройках» → «Сервер».
# Первый зарегистрированный аккаунт становится администратором.
ALLOW_REGISTRATION=1

# Сайт за HTTPS-прокси (nginx, Caddy, облачный балансировщик).
BEHIND_HTTPS_PROXY=1
# Сколько прокси стоит перед сервером (по умолчанию 1 за прокси, иначе 0) — для ограничения попыток входа.
# NUM_PROXIES=1
# Куки только по HTTPS; для запуска по http на своём компьютере — 0.
COOKIE_SECURE=1
