 "notes": [
  {
   "id": "9bea3f14-40ed-48bc-a9e0-03c4e77d9c67",
   "title": "Графы: обход в ширину и в глубину",
   "materialId": "1a992a9d-9ed7-4a3b-8228-4539f5eff7ec",
   "questions": [
    "Чем обход в ширину (BFS) отличается от обхода в глубину (DFS)?",
    "Какой обход находит кратчайший путь в невзвешенном графе и почему?",
    "Какая сложность у BFS и DFS?"
   ],
   "summary": "BFS обходит граф слоями с помощью очереди: сначала все соседи, потом соседи соседей.\nПоэтому BFS находит кратчайший путь по числу рёбер в невзвешенном графе.\nDFS уходит вглубь по одной ветке через стек или рекурсию — удобен для поиска циклов и топологической сортировки.\nСложность обоих — O(V + E).",
   "obsidianUri": "",
   "status": "active",
   "addedOn": "2026-09-18",
   "obsidianPath": null,
   "createdAt": "2026-09-30T10:26:11.536Z"
  },
  {
   "id": "04bb3e16-d32e-4b21-84f6-a045edabb041",
   "title": "Хеш-таблицы и коллизии",
   "materialId": "1a992a9d-9ed7-4a3b-8228-4539f5eff7ec",
   "questions": [
    "Как хеш-таблица находит элемент в среднем за O(1)?",
    "Что такое коллизия и как их разрешают?",
    "Зачем таблицу расширяют при большом заполнении?"
   ],
   "summary": "Хеш-функция превращает ключ в номер ячейки массива, поэтому поиск не перебирает все элементы.\nКоллизия — два ключа попали в одну ячейку. Решения: цепочки (список в ячейке) и открытая адресация.\nКогда таблица заполнена больше чем на ~75%, коллизий много, поэтому массив увеличивают и перераспределяют ключи.",
   "obsidianUri": "",
   "status": "active",
   "addedOn": "2026-09-27",
   "obsidianPath": null,
   "createdAt": "2026-09-30T10:26:11.542Z"
  },
  {
   "id": "d6d81fd6-076c-4a8f-b480-c84aa14de8b1",
   "title": "Двоичный поиск",
   "materialId": "1a992a9d-9ed7-4a3b-8228-4539f5eff7ec",
   "questions": [
    "Какое условие обязательно для двоичного поиска?",
    "Почему сложность O(log n)?",
    "Какая типичная ошибка в реализации?"
   ],
   "summary": "Массив должен быть отсортирован.\nНа каждом шаге сравниваем с серединой и отбрасываем половину, поэтому шагов около log₂ n.\nТипичная ошибка — бесконечный цикл из-за неверного сдвига границ.",
   "obsidianUri": "",
   "status": "active",
   "addedOn": "2026-09-24",
   "obsidianPath": null,
   "createdAt": "2026-09-30T10:26:11.542Z"
  },
  {
   "id": "eb16d0d1-2c42-400c-b04e-383eba257702",
   "title": "Present Perfect и Past Simple",
   "materialId": "2cbcdad4-b55e-4e38-b683-389ac3a10874",
   "questions": [
    "Когда нужен Present Perfect, а когда Past Simple?",
    "Почему нельзя сказать «I have seen him yesterday»?",
    "Какие слова подсказывают Present Perfect?"
   ],
   "summary": "Present Perfect связывает прошлое с настоящим: важен результат или опыт, а не время (I have lost my keys).\nPast Simple — законченное действие в конкретный момент прошлого (I lost my keys yesterday).\nС точным временем в прошлом (yesterday, in 2020) Present Perfect не используется.\nПодсказки: already, yet, just, ever, never, since, for.",
   "obsidianUri": "",
   "status": "active",
   "addedOn": "2026-09-10",
   "obsidianPath": null,
   "createdAt": "2026-09-30T10:26:11.545Z"
  },
  {
   "id": "4c553708-3221-44e6-87a3-82b7c7fbbe22",
   "title": "Модальные глаголы: can, could, be able to",
   "materialId": "2cbcdad4-b55e-4e38-b683-389ac3a10874",
   "questions": [
    "Чем can отличается от be able to?",
    "Как сказать о способности в будущем?",
    "Когда could, а когда was able to?"
   ],
   "summary": "can — способность сейчас. У can нет будущего времени, поэтому там be able to (I will be able to swim).\ncould — общая способность в прошлом (I could swim when I was five).\nwas able to — удалось сделать в конкретной ситуации (I was able to catch the train).",
   "obsidianUri": "",
   "status": "active",
   "addedOn": "2026-09-29",
   "obsidianPath": null,
   "createdAt": "2026-09-30T10:26:11.549Z"
  }
 ],
