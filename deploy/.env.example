# Настройки трекера на сервере. Файл .env рядом создаёт ./setup.sh — он же придумывает пароли.
# После правки: docker compose up -d. Подробно — docs/DEPLOY.md.

# Домен трекера. Его A-запись должна указывать на IP сервера: по домену Caddy получит HTTPS-сертификат.
DOMAIN=tracker.example.com

# Секреты: длинные случайные строки из латинских букв и цифр.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Регистрация на сайте при первом запуске: 1 — открыта, первый аккаунт становится администратором;
# 0 — закрыта, аккаунт создаётся командой
#   docker compose exec app python manage.py adduser me@example.com --admin
# Дальше регистрацию открывает и закрывает администратор: «Настройки» → «Сервер».
ALLOW_REGISTRATION=1

# Часовой пояс: по нему делаются копии и называются их файлы.
TZ=Europe/Moscow

# Резервные копии базы — в папке deploy/backups, каждый день в BACKUP_TIME.
BACKUP_TIME=03:30
# Хранятся все копии за BACKUP_KEEP_DAYS дней, из более старых — последняя копия
# каждой из BACKUP_KEEP_WEEKS недель и каждого из BACKUP_KEEP_MONTHS месяцев.
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=12

# Копии ещё и в облачное хранилище (необязательно): сервер может сломаться вместе с копиями.
# Подойдёт любое S3-совместимое (Yandex Object Storage, VK Cloud, Selectel, Backblaze B2…)
# и всё, что умеет rclone. Бакет создайте заранее в консоли хранилища, ключу хватит прав на запись в него.
# Пример для Yandex Object Storage — уберите # в начале строк ниже и впишите бакет и ключи:
# BACKUP_REMOTE=cloud:имя-бакета/tracker
# RCLONE_CONFIG_CLOUD_TYPE=s3
# RCLONE_CONFIG_CLOUD_PROVIDER=Other
# RCLONE_CONFIG_CLOUD_ENDPOINT=https://storage.yandexcloud.net
# RCLONE_CONFIG_CLOUD_REGION=ru-central1
# RCLONE_CONFIG_CLOUD_ACCESS_KEY_ID=
# RCLONE_CONFIG_CLOUD_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_CLOUD_NO_CHECK_BUCKET=true
